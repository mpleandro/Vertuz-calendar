PORT=3000
# URL pública (sem barra no final). Usada nos links do .ics e nas meta tags.
BASE_URL=http://localhost:3000
# Senha do painel admin (/admin)
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (qualquer string longa)
SESSION_SECRET=troque-este-segredo-longo
# Fuso padrão dos eventos
DEFAULT_TZ=America/Sao_Paulo
