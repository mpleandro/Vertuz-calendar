PORT=3000
# URL pública (sem barra no final). Usada nos links do .ics e nas meta tags.
BASE_URL=https://cal.vertuzclub.com.br
# Login master do painel (/admin). Ele cadastra os profissionais em Configurações > Usuários.
ADMIN_USER=admin
# Senha master. Em produção, o app não sobe com o valor de exemplo.
ADMIN_PASSWORD=defina-uma-senha-forte
# Segredo para assinar o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=gere-um-texto-longo-e-aleatorio
# Fuso padrão dos eventos
DEFAULT_TZ=America/Sao_Paulo
